; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   name=value ; assign values
;   name=value ; other values
; or:
;   section = value_line_1 \
;             value_line_2

config_version=5

[application]

config/name="Shadow Protocol"
config/version="0.1.0"
config/description="A tactical action-adventure game set in a dystopian future controlled by an AI."
config/icon="res://Assets/icon.svg"
run/main_scene="res://Scenes/Main/MainMenu.tscn"

